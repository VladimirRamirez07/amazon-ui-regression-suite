{
  "name": "amazon-ui-regression-suite",
  "version": "1.0.0",
  "description": "Black-box UI regression suite for Amazon.com — Playwright + TypeScript + Page Object Model + Allure Reports + bot evasion",
  "main": "index.js",
  "scripts": {
    "test": "npx playwright test",
    "test:headed": "npx playwright test --headed",
    "test:search": "npx playwright test search.spec.ts",
    "test:filters": "npx playwright test filters.spec.ts",
    "test:cart": "npx playwright test cart.spec.ts",
    "test:subtotal": "npx playwright test subtotal.spec.ts",
    "report:allure": "npx allure generate allure-results --clean -o allure-report && npx allure open allure-report",
    "report:playwright": "npx playwright show-report",
    "clean": "rmdir /s /q allure-results allure-report playwright-report 2>nul || true"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VladimirRamirez07/amazon-ui-regression-suite.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/VladimirRamirez07/amazon-ui-regression-suite/issues"
  },
  "homepage": "https://github.com/VladimirRamirez07/amazon-ui-regression-suite#readme",
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.1",
    "allure-commandline": "^2.41.0",
    "allure-playwright": "^3.9.0",
    "playwright-extra": "^4.3.6",
    "playwright-extra-plugin-stealth": "^0.0.1",
    "typescript": "^6.0.3"
  }
}